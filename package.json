{
    "name": "@rapidmx/acme-server",
    "version": "0.2.0",
    "private": true,
    "description": "The RapidMX ACME certificate authority: issues S/MIME signing and encryption certificates for e-mail addresses over ACME (RFC 8555) with the RFC 8823 email-reply-00 challenge.",
    "type": "module",
    "repository": "https://github.com/rapidmx/acme-server.git",
    "author": "Jean-Philippe Steinmetz <rapidrests@gmail.com>",
    "license": "MPL-2.0",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rapidrest build",
        "ca:init": "tsx scripts/ca-init.ts",
        "debug": "rapidrest dev --inspect",
        "dev": "rapidrest dev",
        "lint": "eslint ./src ./test",
        "local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
        "checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
        "dependency-check": "yarn dlx depcheck \"$@\"",
        "profile:process": "node --prof-process --call-graph",
        "profile:view": "npx speedscope",
        "start": "rapidrest start",
        "test": "rapidrest test --coverage",
        "test:watch": "rapidrest test --watch --coverage",
        "release": "rapidrest release"
    },
    "prettier": {
        "printWidth": 120,
        "semi": true,
        "singleQuote": false,
        "tabWidth": 4,
        "trailingComma": "es5"
    },
    "dependencies": {
        "@peculiar/asn1-ocsp": "^2.9.5",
        "@peculiar/asn1-schema": "^2.9.5",
        "@peculiar/asn1-x509": "^2.9.5",
        "@peculiar/x509": "^2.1.0",
        "@rapidrest/core": "^6.0.0",
        "@rapidrest/service-core": "^2.3.0",
        "@types/node": "^26.5.0",
        "axios": "^1.20.0",
        "jose": "^6.2.12",
        "lodash-es": "^4.18.1",
        "mailauth": "^5.0.3",
        "mailparser": "^3.9.28",
        "mongodb": "^7.6.0",
        "nconf": "^0.13.0",
        "nodemailer": "^10.0.1",
        "openapi3-ts": "^4.6.1",
        "prom-client": "^15.1.3",
        "redis": "^6.2.1",
        "reflect-metadata": "^0.2.2",
        "smtp-server": "^3.19.13",
        "winston": "^3.19.0",
        "winston-transport": "^4.9.0"
    },
    "devDependencies": {
        "@rapidrest/cli": "^2.1.0",
        "@swc/core": "^1.16.2",
        "@types/mailparser": "^3.4.6",
        "@types/nconf": "^0.10.7",
        "@types/nodemailer": "^8.0.1",
        "@types/smtp-server": "^3.5.13",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitest/coverage-v8": "^5.0.0",
        "acme-client": "^5.4.0",
        "eslint": "^10.10.0",
        "eslint-plugin-jsdoc": "^64.3.8",
        "fengari": "^0.1.5",
        "globals": "^17.12.0",
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^3.1.14",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.13",
        "typeorm": "^1.1.1",
        "typescript": "^6.0.3",
        "unplugin-swc": "^1.6.0",
        "uuid": "^14.0.2",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    },
    "resolutions": {
        "cross-spawn": "^7.0.6",
        "mailauth/nodemailer": "10.0.10"
    },
    "packageManager": "yarn@4.2.2",
    "engines": {
        "node": ">=24.0.0"
    }
}
